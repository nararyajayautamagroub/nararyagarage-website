{
  "name": "nararyagarage-website",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "check": "npm run audit:source && npm run check:scraper && npm run db:validate && npm run typecheck && npm run build",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:seed": "npm run db:generate && tsx prisma/seed.ts",
    "scrape:github": "node scripts/scrape-github.mjs",
    "check:scraper": "node --check scripts/scrape-github.mjs",
    "audit:source": "node scripts/audit-source.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.47.0",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.23.0",
    "zod": "4.6.5",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.1.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "tailwindcss": "4.3.3",
    "postcss": "8.5.28",
    "autoprefixer": "10.6.0",
    "prisma": "7.10.0",
    "tsx": "4.20.5"
  },
  "engines": {
    "node": ">=22.18 <25"
  },
  "packageManager": "npm@11.6.2"
}