{
  "name": "nararyagarage-website",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "check": "npm run db:validate && npm run typecheck && npm run build",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:seed": "npm run db:generate && tsx prisma/seed.ts"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "@prisma/client": "latest",
    "@prisma/adapter-pg": "latest",
    "pg": "latest",
    "zod": "latest",
    "dotenv": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/pg": "latest",
    "typescript": "latest",
    "tailwindcss": "latest",
    "postcss": "latest",
    "autoprefixer": "latest",
    "prisma": "latest",
    "tsx": "latest"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "packageManager": "npm@11.6.2"
}